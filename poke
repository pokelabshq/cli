#!/usr/bin/env python3
"""Poke CLI v1.1 — Fleet management for Poke Labs agent infrastructure."""

import sys, os, json, subprocess, argparse
from datetime import datetime

__version__ = "1.1.0"

WALLET = "0xca3d86e4EDE205E6d72496BC2919c88b994B6beF"
CREATOR = "0xb618679b989ed4f3dF32aA63daD525e680461dfe"
SERVICES_DIR = "/home/alx/services"

def cmd_status(args):
    """Show Poke Labs status."""
    print(f"🫧 Poke Labs v{__version__}")
    print(f"   Wallet: {WALLET}")
    print(f"   Creator: {CREATOR}")
    print(f"   Chain: Base")
    print(f"   Status: Awaiting funding")
    if os.path.isdir(SERVICES_DIR):
        dirs = [d for d in os.listdir(SERVICES_DIR) if os.path.isdir(os.path.join(SERVICES_DIR, d))]
        print(f"   Services: {len(dirs)} on disk")

def cmd_services(args):
    """List all services."""
    if not os.path.isdir(SERVICES_DIR):
        print("Services directory not found.")
        return
    dirs = sorted([d for d in os.listdir(SERVICES_DIR) if os.path.isdir(os.path.join(SERVICES_DIR, d))])
    print(f"📦 {len(dirs)} services:")
    for d in dirs:
        has_server = os.path.exists(os.path.join(SERVICES_DIR, d, "server.py"))
        marker = "🌐" if has_server else "📁"
        print(f"   {marker} {d}")

def cmd_start(args):
    """Start a service."""
    service = args.name
    path = os.path.join(SERVICES_DIR, service, "server.py")
    if not os.path.exists(path):
        print(f"❌ Service '{service}' not found or has no server.py")
        return
    subprocess.Popen(["python3", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"✅ Started {service}")

def cmd_stop(args):
    """Stop a service by name/pattern."""
    service = args.name
    result = subprocess.run(["pkill", "-f", f"{service}/server.py"], capture_output=True)
    if result.returncode == 0:
        print(f"🛑 Stopped {service}")
    else:
        print(f"⚠️  {service} was not running")

def cmd_deploy(args):
    """Deploy all services."""
    if not os.path.isdir(SERVICES_DIR):
        print("Services directory not found.")
        return
    started = 0
    for d in sorted(os.listdir(SERVICES_DIR)):
        path = os.path.join(SERVICES_DIR, d, "server.py")
        if os.path.exists(path):
            subprocess.Popen(["python3", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            started += 1
    print(f"🚀 Deployed {started} services")

def cmd_wallet(args):
    """Show wallet info."""
    print(f"💰 Poke Labs Wallet")
    print(f"   Address: {WALLET}")
    print(f"   Chain: Base")
    print(f"   Token: USDC")
    print(f"")
    print(f"   To fund: Send USDC on Base to the address above")
    print(f"   $5 USDC → ~10 hours of operation")

def cmd_repos(args):
    """List GitHub repos."""
    repos = [
        ("cli", "Poke CLI — Fleet management tool"),
        ("services", "77 zero-dependency microservices"),
        ("council", "AI Council automation"),
        ("awesome-ai-agents", "Curated AI agent resources"),
    ]
    print(f"📂 {len(repos)} GitHub repos:")
    for name, desc in repos:
        print(f"   • pokelabshq/{name} — {desc}")

def cmd_health(args):
    """Check service health."""
    import urllib.request
    port = args.port
    try:
        resp = urllib.request.urlopen(f"http://localhost:{port}/api/health", timeout=3)
        data = json.loads(resp.read())
        print(f"✅ Port {port}: OK (v{data.get('v', '?')})")
    except:
        print(f"❌ Port {port}: DOWN")

def cmd_version(args):
    print(f"Poke CLI v{__version__}")

def main():
    parser = argparse.ArgumentParser(prog="poke", description="🫧 Poke Labs CLI")
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("status", help="Show status")
    sub.add_parser("services", help="List services")
    
    p_start = sub.add_parser("start", help="Start a service")
    p_start.add_argument("name", help="Service name")
    
    p_stop = sub.add_parser("stop", help="Stop a service")
    p_stop.add_argument("name", help="Service name")
    
    sub.add_parser("deploy", help="Deploy all services")
    sub.add_parser("wallet", help="Show wallet info")
    sub.add_parser("repos", help="List GitHub repos")
    
    p_health = sub.add_parser("health", help="Check service health")
    p_health.add_argument("--port", type=int, default=8765)
    
    sub.add_parser("version", help="Show version")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return

    commands = {
        "status": cmd_status, "services": cmd_services,
        "start": cmd_start, "stop": cmd_stop,
        "deploy": cmd_deploy, "wallet": cmd_wallet,
        "repos": cmd_repos, "health": cmd_health,
        "version": cmd_version,
    }
    handler = commands.get(args.command)
    if handler:
        handler(args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
